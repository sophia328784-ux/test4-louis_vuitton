<?xml version="1.0" encoding="utf-8"?>
<layer-list xmlns:android="http://schemas.android.com/apk/res/android">
    <item>
        <rotate
            android:fromDegrees="90"
            android:toDegrees="90"
            android:pivotX="50%"
            android:pivotY="50%">
            <shape android:shape="line">
                <size
                    android:height="140dp"
                    android:width="140dp"/>
                <stroke
                    android:width="1dp"
                    android:color="@android:color/white"
                    android:dashWidth="4dp"
                    android:dashGap="3dp"/>
            </shape>
        </rotate>
    </item>
    <item
        android:left="62dp"
        android:top="-8dp"
        android:right="62dp"
        android:bottom="132dp">
        <shape android:shape="oval">
            <solid android:color="@color/off_white"/>
        </shape>
    </item>
    <item
        android:left="62dp"
        android:top="132dp"
        android:right="62dp"
        android:bottom="-8dp">
        <shape android:shape="oval">
            <solid android:color="@color/off_white"/>
        </shape>
    </item>
</layer-list>
