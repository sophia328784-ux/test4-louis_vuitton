<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:orientation="horizontal"
    android:background="@android:color/white"
    android:paddingTop="24dp"
    android:paddingBottom="24dp"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:foreground="?android:attr/selectableItemBackground"
    android:paddingStart="16dp"
    android:paddingEnd="16dp">
    <TextView
        android:id="@+id/text_item_title"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:text="@string/light_up_battery"
        android:layout_weight="4"
        style="@style/ListLabelLMediumLeftDark"/>
    <LinearLayout
        android:gravity="end|center_vertical"
        android:orientation="horizontal"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_weight="1">
        <TextView
            android:id="@+id/text_battery_left"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/light_up_sneaker_initial_left"
            android:layout_marginEnd="16dp"
            style="@style/ListLabelLMediumLeftDark"/>
        <ImageView
            android:id="@+id/image_battery_level_left"
            android:layout_width="16dp"
            android:layout_height="16dp"
            android:src="@drawable/ic_battery_100"/>
    </LinearLayout>
    <LinearLayout
        android:gravity="end|center_vertical"
        android:orientation="horizontal"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_weight="1">
        <TextView
            android:id="@+id/text_battery_right"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/light_up_sneaker_initial_right"
            android:layout_marginEnd="16dp"
            style="@style/ListLabelLMediumLeftDark"/>
        <ImageView
            android:id="@+id/image_battery_level_right"
            android:layout_width="16dp"
            android:layout_height="16dp"
            android:src="@drawable/ic_battery_100"/>
    </LinearLayout>
</LinearLayout>
