<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_gravity="center_horizontal"
    android:background="@drawable/shadow_trunk_speaker_device_type"
    android:layout_width="match_parent"
    android:layout_height="wrap_content">
    <androidx.cardview.widget.CardView
        android:id="@+id/speaker_room_layout"
        android:focusable="true"
        android:clickable="true"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:foreground="?attr/selectableItemBackground"
        app:cardCornerRadius="@dimen/repaint_card_view_radius"
        app:cardElevation="0dp">
        <RelativeLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content">
            <LinearLayout
                android:orientation="vertical"
                android:id="@+id/speaker_room_item"
                android:layout_width="match_parent"
                android:layout_height="wrap_content">
                <com.vuitton.android.presentation.view.FixedAspectRatioImageView
                    android:background="@color/egg_shell"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:src="0x7f08039b"
                    android:scaleType="centerCrop"
                    app:imageViewAspectRatio="1:1"/>
                <TextView
                    android:gravity="bottom"
                    android:id="@+id/speaker_room_title"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="@dimen/double_spacing"
                    android:layout_marginBottom="@dimen/midplus_spacing"
                    android:text="Speaker Trunk Room"
                    android:layout_marginHorizontal="@dimen/double_spacing"
                    style="@style/HeadingH5LeftDark"/>
                <TextView
                    android:ellipsize="end"
                    android:id="@+id/speaker_room_subtitle"
                    android:paddingBottom="@dimen/double_spacing"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:maxLines="1"
                    android:lines="1"
                    android:fontFamily="@font/louisvuitton_regular"
                    android:textDirection="locale"
                    android:layout_marginHorizontal="@dimen/double_spacing"
                    style="@style/ListLabelSRegularLeftGrey"/>
            </LinearLayout>
            <TextView
                android:id="@+id/speaker_room_count"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/double_spacing"
                android:layout_alignParentTop="true"
                android:fontFamily="@font/louisvuitton_regular"
                android:layout_marginStart="@dimen/double_spacing"
                android:layout_alignParentStart="true"
                style="@style/ListLabelSRegularLeftGrey"/>
        </RelativeLayout>
    </androidx.cardview.widget.CardView>
</FrameLayout>
