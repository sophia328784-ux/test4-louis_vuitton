<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:orientation="vertical"
    android:background="@drawable/border_top_radius_16dp_white"
    android:paddingBottom="@dimen/double_spacing"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:paddingStart="@dimen/double_spacing"
    android:paddingEnd="@dimen/double_spacing">
    <TextView
        android:id="@+id/text_title"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="@dimen/triple_spacing"
        android:text="@string/trunk_choose_connection_type_title"
        android:layout_marginStart="@dimen/double_spacing"
        android:layout_marginEnd="@dimen/double_spacing"
        style="@style/HeadingH5CenterDark"/>
    <TextView
        android:id="@+id/text_subtitle"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="@dimen/default_spacing"
        android:layout_marginBottom="@dimen/triple_spacing"
        android:text="@string/trunk_choose_connection_type_subtitle"
        android:fontFamily="@font/louisvuitton_regular"
        style="@style/ListLabelXlRegularCenterGrey"/>
    <FrameLayout
        android:background="@drawable/shadow_trunk_speaker_connection_type"
        android:layout_width="match_parent"
        android:layout_height="wrap_content">
        <androidx.cardview.widget.CardView
            android:id="@+id/card_bluetooth_connection"
            android:focusable="true"
            android:clickable="true"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:foreground="?attr/selectableItemBackground"
            app:cardCornerRadius="@dimen/repaint_card_view_radius"
            app:cardElevation="@dimen/no_elevation">
            <androidx.constraintlayout.widget.ConstraintLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:paddingStart="0dp"
                android:paddingEnd="@dimen/default_spacing">
                <FrameLayout
                    android:id="@+id/layout_bluetooth_connection_image"
                    android:background="@color/off_white"
                    android:layout_width="80dp"
                    android:layout_height="80dp"
                    app:layout_constraintStart_toStartOf="parent"
                    app:layout_constraintTop_toTopOf="parent">
                    <ImageView
                        android:layout_gravity="center"
                        android:layout_width="28dp"
                        android:layout_height="28dp"
                        android:src="@drawable/ic_trunk_connection_type_bluetooth"
                        android:scaleType="centerCrop"/>
                </FrameLayout>
                <TextView
                    android:orientation="vertical"
                    android:id="@+id/bluetooth_connection_title"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="@string/trunk_speaker_connect_bluetooth"
                    android:textAllCaps="true"
                    android:fontFamily="@font/louisvuitton_medium"
                    android:layout_marginStart="@dimen/double_spacing"
                    app:layout_constraintBottom_toBottomOf="parent"
                    app:layout_constraintStart_toEndOf="@+id/layout_bluetooth_connection_image"
                    app:layout_constraintTop_toTopOf="parent"
                    style="@style/ListLabelMMediumLeftDark"/>
            </androidx.constraintlayout.widget.ConstraintLayout>
        </androidx.cardview.widget.CardView>
    </FrameLayout>
    <FrameLayout
        android:background="@drawable/shadow_trunk_speaker_connection_type"
        android:layout_width="match_parent"
        android:layout_height="wrap_content">
        <androidx.cardview.widget.CardView
            android:id="@+id/card_wifi_connection"
            android:focusable="true"
            android:clickable="true"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:foreground="?attr/selectableItemBackground"
            app:cardCornerRadius="@dimen/repaint_card_view_radius"
            app:cardElevation="@dimen/no_elevation">
            <androidx.constraintlayout.widget.ConstraintLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content">
                <FrameLayout
                    android:id="@+id/layout_wifi_connection_image"
                    android:background="@color/off_white"
                    android:layout_width="80dp"
                    android:layout_height="80dp"
                    app:layout_constraintStart_toStartOf="parent"
                    app:layout_constraintTop_toTopOf="parent">
                    <ImageView
                        android:layout_gravity="center"
                        android:layout_width="28dp"
                        android:layout_height="28dp"
                        android:src="@drawable/ic_trunk_connection_type_wifi"
                        android:scaleType="centerCrop"/>
                </FrameLayout>
                <TextView
                    android:orientation="vertical"
                    android:id="@+id/wifi_connection_title"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="@string/trunk_speaker_connect_wifi"
                    android:textAllCaps="true"
                    android:fontFamily="@font/louisvuitton_medium"
                    android:layout_marginStart="@dimen/double_spacing"
                    app:layout_constraintBottom_toBottomOf="parent"
                    app:layout_constraintStart_toEndOf="@+id/layout_wifi_connection_image"
                    app:layout_constraintTop_toTopOf="parent"
                    style="@style/ListLabelMMediumLeftDark"/>
            </androidx.constraintlayout.widget.ConstraintLayout>
        </androidx.cardview.widget.CardView>
    </FrameLayout>
    <Button
        android:id="@+id/button_back"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="@dimen/triple_spacing"
        android:text="@string/back"
        android:textAllCaps="false"
        style="@style/SecondaryButtonRepaint"/>
</LinearLayout>
