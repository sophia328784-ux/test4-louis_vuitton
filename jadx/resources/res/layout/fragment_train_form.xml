<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:orientation="vertical"
    android:background="@color/off_white"
    android:paddingTop="24dp"
    android:paddingBottom="24dp"
    android:layout_width="match_parent"
    android:layout_height="wrap_content">
    <LinearLayout
        android:orientation="vertical"
        android:background="@android:color/white"
        android:padding="24dp"
        android:layout_width="match_parent"
        android:layout_height="wrap_content">
        <TextView
            android:id="@+id/train_departure_title"
            android:focusable="true"
            android:focusableInTouchMode="true"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="@string/departure"
            style="@style/HeadingH6LeftDark"/>
        <com.google.android.material.textfield.TextInputLayout
            android:textColorHint="@color/eternity"
            android:id="@+id/departure_date_layout"
            android:paddingTop="24dp"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            app:errorTextAppearance="@style/ErrorTextAppearance">
            <EditText
                android:id="@+id/departure_date"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:inputType="date"
                app:backgroundTint="@color/westargrey70"
                style="@style/FormEditText"/>
        </com.google.android.material.textfield.TextInputLayout>
        <com.google.android.material.textfield.TextInputLayout
            android:textColorHint="@color/eternity"
            android:id="@+id/departure_hour_layout"
            android:paddingTop="24dp"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            app:errorTextAppearance="@style/ErrorTextAppearance">
            <EditText
                android:id="@+id/departure_hour"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:inputType="text"
                app:backgroundTint="@color/westargrey70"
                style="@style/FormEditText"/>
        </com.google.android.material.textfield.TextInputLayout>
        <com.google.android.material.textfield.TextInputLayout
            android:textColorHint="@color/eternity"
            android:id="@+id/departure_station_layout"
            android:paddingTop="24dp"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            app:errorTextAppearance="@style/ErrorTextAppearance">
            <EditText
                android:id="@+id/departure_station"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:inputType="textMultiLine"
                app:backgroundTint="@color/westargrey70"
                style="@style/FormEditText"/>
        </com.google.android.material.textfield.TextInputLayout>
    </LinearLayout>
    <LinearLayout
        android:orientation="vertical"
        android:background="@android:color/white"
        android:padding="24dp"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="24dp">
        <TextView
            android:id="@+id/train_arrival_title"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="@string/arrival"
            style="@style/HeadingH6LeftDark"/>
        <com.google.android.material.textfield.TextInputLayout
            android:textColorHint="@color/eternity"
            android:id="@+id/arrival_date_layout"
            android:paddingTop="24dp"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            app:errorTextAppearance="@style/ErrorTextAppearance">
            <EditText
                android:id="@+id/arrival_date"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:inputType="date"
                app:backgroundTint="@color/westargrey70"
                style="@style/FormEditText"/>
        </com.google.android.material.textfield.TextInputLayout>
        <com.google.android.material.textfield.TextInputLayout
            android:textColorHint="@color/eternity"
            android:id="@+id/arrival_hour_layout"
            android:paddingTop="24dp"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            app:errorTextAppearance="@style/ErrorTextAppearance">
            <EditText
                android:id="@+id/arrival_hour"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:inputType="text"
                app:backgroundTint="@color/westargrey70"
                style="@style/FormEditText"/>
        </com.google.android.material.textfield.TextInputLayout>
        <com.google.android.material.textfield.TextInputLayout
            android:textColorHint="@color/eternity"
            android:id="@+id/arrival_station_layout"
            android:paddingTop="24dp"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            app:errorTextAppearance="@style/ErrorTextAppearance">
            <EditText
                android:id="@+id/arrival_station"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:inputType="textMultiLine"
                app:backgroundTint="@color/westargrey70"
                style="@style/FormEditText"/>
        </com.google.android.material.textfield.TextInputLayout>
    </LinearLayout>
    <LinearLayout
        android:orientation="vertical"
        android:background="@android:color/white"
        android:padding="24dp"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="24dp">
        <TextView
            android:id="@+id/train_info_title"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="@string/travel_train_title"
            style="@style/HeadingH6LeftDark"/>
        <com.google.android.material.textfield.TextInputLayout
            android:textColorHint="@color/eternity"
            android:id="@+id/train_reference_layout"
            android:paddingTop="24dp"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            app:errorTextAppearance="@style/ErrorTextAppearance">
            <EditText
                android:id="@+id/train_reference"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:inputType="textCapCharacters"
                android:imeOptions="actionNext"
                app:backgroundTint="@color/westargrey70"
                style="@style/FormEditText"/>
        </com.google.android.material.textfield.TextInputLayout>
        <com.google.android.material.textfield.TextInputLayout
            android:textColorHint="@color/eternity"
            android:id="@+id/coach_layout"
            android:paddingTop="24dp"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            app:errorTextAppearance="@style/ErrorTextAppearance">
            <EditText
                android:id="@+id/coach"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:hint="@string/train_coach"
                android:inputType="textCapCharacters"
                android:imeOptions="actionNext"
                app:backgroundTint="@color/westargrey70"
                style="@style/FormEditText"/>
        </com.google.android.material.textfield.TextInputLayout>
        <com.google.android.material.textfield.TextInputLayout
            android:textColorHint="@color/eternity"
            android:id="@+id/seat_reference_layout"
            android:paddingTop="24dp"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            app:errorTextAppearance="@style/ErrorTextAppearance">
            <EditText
                android:id="@+id/seat_reference"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:hint="@string/seat_number"
                android:inputType="textCapCharacters"
                android:imeOptions="actionDone"
                app:backgroundTint="@color/westargrey70"
                style="@style/FormEditText"/>
        </com.google.android.material.textfield.TextInputLayout>
    </LinearLayout>
</LinearLayout>
