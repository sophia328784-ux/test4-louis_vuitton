<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:orientation="vertical"
    android:background="@color/black"
    android:layout_width="match_parent"
    android:layout_height="match_parent">
    <ImageView
        android:layout_gravity="end"
        android:id="@+id/image_close_screen"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="@dimen/double_spacing"
        android:src="@drawable/ic_close_repaint"
        android:contentDescription="@string/btn_close"
        android:layout_marginEnd="@dimen/double_spacing"/>
    <TextView
        android:gravity="center"
        android:id="@+id/text_pairing_title"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:text="@string/light_up_searching_for_trainers"
        android:layout_weight="1"
        android:layout_marginStart="@dimen/double_spacing"
        android:layout_marginEnd="@dimen/double_spacing"
        style="@style/HeadingH4CenterLight"/>
    <ImageView
        android:layout_gravity="center_horizontal"
        android:id="@+id/image_pairing_visual"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:src="0x7f08037a"
        android:layout_weight="1"
        android:contentDescription="@null"/>
    <Button
        android:id="@+id/button_start_pairing"
        android:background="@drawable/selector_pairing_button_light_up"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginBottom="@dimen/double_spacing"
        android:text="@string/light_up_pairing_trainers"
        android:layout_marginStart="@dimen/double_spacing"
        android:layout_marginEnd="@dimen/double_spacing"
        style="@style/SecondaryButtonRepaint"/>
</LinearLayout>
