<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:orientation="vertical"
    android:background="@color/black"
    android:layout_width="match_parent"
    android:layout_height="match_parent">
    <include
        android:id="@+id/toolbar_simple"
        layout="@layout/toolbar_simple"/>
    <FrameLayout
        android:background="@color/off_white"
        android:layout_width="match_parent"
        android:layout_height="match_parent">
        <ProgressBar
            android:layout_gravity="center"
            android:id="@+id/progress_connectivity"
            android:layout_width="32dp"
            android:layout_height="32dp"
            style="@style/LVProgressBarDark"/>
        <include
            android:id="@+id/layout_connectivity_paired"
            android:visibility="gone"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            layout="@layout/connectivity_paired_layout"/>
        <include
            android:id="@+id/layout_connectivity_not_paired"
            android:visibility="gone"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            layout="@layout/connectivity_not_paired_layout"/>
        <LinearLayout
            android:gravity="center"
            android:orientation="vertical"
            android:id="@+id/layout_connectivity_pairing_overlay"
            android:background="@color/transparent_background_white"
            android:focusable="true"
            android:visibility="gone"
            android:layout_width="match_parent"
            android:layout_height="match_parent">
            <ProgressBar
                android:layout_width="32dp"
                android:layout_height="32dp"
                style="@style/LVProgressBarDark"/>
            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/connected_objects_pairing"/>
        </LinearLayout>
    </FrameLayout>
</LinearLayout>
