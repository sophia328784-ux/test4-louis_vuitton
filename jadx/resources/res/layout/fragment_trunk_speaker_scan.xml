<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:orientation="vertical"
    android:background="@color/black"
    android:layout_width="match_parent"
    android:layout_height="match_parent">
    <ImageView
        android:layout_gravity="end"
        android:id="@+id/image_close_screen"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="16dp"
        android:src="@drawable/ic_close_repaint"
        android:contentDescription="@string/btn_close"
        android:layout_marginEnd="16dp"/>
    <ImageView
        android:layout_gravity="center_horizontal"
        android:id="@+id/pairing_image"
        android:layout_width="wrap_content"
        android:layout_height="0dp"
        android:src="0x7f08039c"
        android:adjustViewBounds="true"
        android:layout_weight="1"
        android:contentDescription="@null"/>
    <Button
        android:id="@+id/start_pairing_button"
        android:background="@drawable/selector_pairing_button_light_up"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginBottom="16dp"
        android:text="@string/pairing_trunk_speaker"
        android:layout_marginStart="16dp"
        android:layout_marginEnd="16dp"
        style="@style/SecondaryButtonRepaint"/>
</LinearLayout>
