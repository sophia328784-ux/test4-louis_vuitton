<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:orientation="vertical"
    android:layout_width="match_parent"
    android:layout_height="match_parent">
    <include
        android:id="@+id/layout_toolbar"
        layout="@layout/toolbar_simple"/>
    <androidx.core.widget.NestedScrollView
        android:id="@+id/scroll"
        android:background="@color/off_white"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:fillViewport="true">
        <LinearLayout
            android:orientation="vertical"
            android:layout_width="match_parent"
            android:layout_height="wrap_content">
            <ImageView
                android:id="@+id/watch_image"
                android:background="@color/white"
                android:layout_width="match_parent"
                android:layout_height="360dp"
                android:src="@drawable/vertical_watch_image"/>
            <androidx.constraintlayout.widget.ConstraintLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content">
                <TextView
                    android:id="@+id/watch_details_watchface_title"
                    android:padding="0dp"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="34dp"
                    android:text="@string/p12_tutorial_section2_title"
                    android:layout_marginStart="@dimen/triple_spacing"
                    app:layout_constraintStart_toStartOf="parent"
                    app:layout_constraintTop_toTopOf="parent"
                    style="@style/HeadingH6LeftDark"/>
                <LinearLayout
                    android:orientation="vertical"
                    android:id="@+id/watch_details_see_all_watchfaces"
                    android:background="?android:attr/selectableItemBackground"
                    android:padding="@dimen/small_spacing"
                    android:focusable="true"
                    android:visibility="gone"
                    android:clickable="true"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginEnd="@dimen/triple_spacing"
                    app:layout_constraintEnd_toEndOf="parent"
                    app:layout_constraintTop_toTopOf="@+id/watch_details_watchface_title">
                    <TextView
                        android:textSize="@dimen/text_size_button"
                        android:textColor="@color/eternity"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="@string/luggage_notifications_see_all"
                        android:fontFamily="@font/louisvuitton_regular"/>
                    <View
                        android:background="@color/eternity"
                        android:layout_width="match_parent"
                        android:layout_height="1dp"
                        android:layout_marginTop="1dp"/>
                </LinearLayout>
                <ProgressBar
                    android:layout_gravity="center"
                    android:id="@+id/watch_details_watchface_loader"
                    android:layout_width="32dp"
                    android:layout_height="248dp"
                    android:layout_marginTop="30dp"
                    android:layout_marginBottom="30dp"
                    app:layout_constraintEnd_toEndOf="parent"
                    app:layout_constraintStart_toStartOf="parent"
                    app:layout_constraintTop_toBottomOf="@+id/watch_details_watchface_title"
                    style="@style/LVProgressBarDark"/>
                <androidx.recyclerview.widget.RecyclerView
                    android:orientation="horizontal"
                    android:id="@+id/watchface_recycler_view"
                    android:clipToPadding="false"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="@dimen/triple_spacing"
                    android:layoutDirection="locale"
                    android:paddingStart="@dimen/triple_spacing"
                    android:paddingEnd="@dimen/triple_spacing"
                    app:layoutManager="androidx.recyclerview.widget.LinearLayoutManager"
                    app:layout_constraintTop_toBottomOf="@+id/watch_details_watchface_title"/>
                <TextView
                    android:id="@+id/watch_details_travels_title"
                    android:padding="0dp"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="34dp"
                    android:text="@string/my_travel"
                    android:layout_marginStart="@dimen/triple_spacing"
                    app:layout_constraintStart_toStartOf="parent"
                    app:layout_constraintTop_toBottomOf="@+id/watchface_recycler_view"
                    style="@style/HeadingH6LeftDark"/>
                <LinearLayout
                    android:orientation="vertical"
                    android:id="@+id/watch_details_see_all_travels"
                    android:background="?android:attr/selectableItemBackground"
                    android:padding="@dimen/small_spacing"
                    android:focusable="true"
                    android:visibility="gone"
                    android:clickable="true"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginEnd="@dimen/triple_spacing"
                    android:accessibilityTraversalAfter="@+id/watch_details_travels_title"
                    app:layout_constraintEnd_toEndOf="parent"
                    app:layout_constraintTop_toTopOf="@+id/watch_details_travels_title">
                    <TextView
                        android:textSize="@dimen/text_size_button"
                        android:textColor="@color/eternity"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="@string/luggage_notifications_see_all"
                        android:fontFamily="@font/louisvuitton_regular"/>
                    <View
                        android:background="@color/eternity"
                        android:layout_width="match_parent"
                        android:layout_height="1dp"
                        android:layout_marginTop="1dp"/>
                </LinearLayout>
                <FrameLayout
                    android:id="@+id/watch_details_travels_container"
                    android:paddingTop="@dimen/triple_spacing"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    app:layout_constraintTop_toBottomOf="@+id/watch_details_travels_title">
                    <androidx.recyclerview.widget.RecyclerView
                        android:orientation="horizontal"
                        android:id="@+id/travel_recycler_view"
                        android:visibility="visible"
                        android:clipToPadding="false"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layoutDirection="locale"
                        android:paddingStart="@dimen/double_spacing"
                        android:paddingEnd="26dp"
                        app:layoutManager="androidx.recyclerview.widget.LinearLayoutManager"/>
                    <ProgressBar
                        android:layout_gravity="center"
                        android:id="@+id/watch_details_travels_loader"
                        android:visibility="gone"
                        android:layout_width="32dp"
                        android:layout_height="158dp"
                        style="@style/LVProgressBarDark"/>
                </FrameLayout>
                <Button
                    android:id="@+id/watch_details_travels_add"
                    android:visibility="gone"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="@dimen/triple_spacing"
                    android:text="@string/add_travel"
                    app:layout_constraintTop_toBottomOf="@+id/watch_details_travels_container"
                    style="@style/BlackButton"/>
                <androidx.constraintlayout.widget.ConstraintLayout
                    android:id="@+id/flight_address_card"
                    android:background="@color/white"
                    android:paddingTop="@dimen/huge_spacing"
                    android:paddingBottom="@dimen/double_biggest_spacing"
                    android:visibility="gone"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="@dimen/huge_spacing"
                    android:paddingStart="@dimen/triple_spacing"
                    android:paddingEnd="@dimen/triple_spacing"
                    app:layout_constraintTop_toBottomOf="@+id/watchface_recycler_view">
                    <TextView
                        android:id="@+id/flight_address_label"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:text="@string/my_flight_address"
                        app:layout_constraintTop_toTopOf="parent"
                        style="@style/HeadingH6LeftDark"/>
                    <TextView
                        android:textSize="@dimen/text_size_body_xs"
                        android:textColor="@color/eternity"
                        android:id="@+id/flight_address"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="@dimen/default_spacing"
                        android:textIsSelectable="true"
                        android:fontFamily="@font/louisvuitton_regular"
                        app:layout_constraintTop_toBottomOf="@+id/flight_address_label"/>
                    <TextView
                        android:textSize="@dimen/text_size_h7"
                        android:textColor="@color/eternity"
                        android:id="@+id/sku_label"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="@dimen/double_spacing"
                        android:text="@string/technical_infos_sku"
                        android:fontFamily="@font/louisvuitton_medium"
                        android:layout_marginEnd="@dimen/small_spacing"
                        app:layout_constraintStart_toStartOf="parent"
                        app:layout_constraintTop_toBottomOf="@+id/flight_address"/>
                    <TextView
                        android:textSize="@dimen/text_size_list_label_l"
                        android:textColor="@color/eternity"
                        android:id="@+id/sku"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:fontFamily="@font/louisvuitton_medium"
                        app:layout_constraintBottom_toBottomOf="@+id/sku_label"
                        app:layout_constraintStart_toStartOf="@+id/serial_number"
                        app:layout_constraintTop_toTopOf="@+id/sku_label"/>
                    <TextView
                        android:textSize="@dimen/text_size_h7"
                        android:textColor="@color/eternity"
                        android:id="@+id/serial_number_label"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="@dimen/normal_spacing"
                        android:text="@string/technical_infos_serial_number"
                        android:fontFamily="@font/louisvuitton_medium"
                        android:layout_marginEnd="@dimen/small_spacing"
                        app:layout_constraintStart_toStartOf="parent"
                        app:layout_constraintTop_toBottomOf="@+id/sku_label"/>
                    <TextView
                        android:textSize="@dimen/text_size_list_label_l"
                        android:textColor="@color/eternity"
                        android:id="@+id/serial_number"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:fontFamily="@font/louisvuitton_medium"
                        android:layout_marginStart="60dp"
                        app:layout_constraintBottom_toBottomOf="@+id/serial_number_label"
                        app:layout_constraintStart_toEndOf="@+id/serial_number_label"
                        app:layout_constraintTop_toTopOf="@+id/serial_number_label"/>
                </androidx.constraintlayout.widget.ConstraintLayout>
            </androidx.constraintlayout.widget.ConstraintLayout>
        </LinearLayout>
    </androidx.core.widget.NestedScrollView>
</LinearLayout>
