<?xml version="1.0" encoding="utf-8"?>
<RelativeLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent">
    <include
        android:id="@+id/speaker_trunk_toolbar"
        layout="@layout/toolbar_simple"/>
    <androidx.core.widget.NestedScrollView
        android:id="@+id/scroll_view_wrapper"
        android:background="@color/off_white"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:fillViewport="true"
        android:layout_above="@+id/equalizer_wrapper"
        android:layout_below="@+id/speaker_trunk_toolbar">
        <LinearLayout
            android:orientation="vertical"
            android:focusable="true"
            android:focusableInTouchMode="true"
            android:clickable="true"
            android:layout_width="match_parent"
            android:layout_height="wrap_content">
            <RelativeLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content">
                <com.vuitton.android.presentation.screen.connectivity.views.FixedAspectRatioImageView
                    android:id="@+id/trunk_main_image"
                    android:layout_width="match_parent"
                    android:layout_height="360dp"
                    android:src="0x7f080397"
                    android:scaleType="centerCrop"
                    app:imageViewAspectRatio="1:1"/>
                <ImageView
                    android:id="@+id/play_pause_icon"
                    android:focusable="true"
                    android:visibility="gone"
                    android:clickable="true"
                    android:layout_width="wrap_content"
                    android:layout_height="24dp"
                    android:layout_marginTop="@dimen/double_spacing"
                    android:src="@drawable/ic_trunk_play"
                    android:paddingStart="@dimen/double_spacing"
                    android:paddingEnd="@dimen/double_spacing"
                    android:layout_alignParentEnd="true"/>
                <com.vuitton.android.presentation.screen.connectivity.views.TrunkBatteryLevelView
                    android:id="@+id/speaker_trunk_battery_level"
                    android:visibility="gone"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="@dimen/double_spacing"
                    android:layout_marginStart="@dimen/double_spacing"/>
            </RelativeLayout>
            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="@string/TRUNK_SPEAKER_INFORMATIONS"
                android:textDirection="locale"
                android:layout_marginHorizontal="@dimen/double_spacing"
                android:layout_marginVertical="@dimen/triple_spacing"
                style="@style/HeadingH4LeftDark"/>
            <LinearLayout
                android:orientation="vertical"
                android:background="@color/white"
                android:paddingTop="@dimen/triple_spacing"
                android:focusable="true"
                android:focusableInTouchMode="true"
                android:clickable="true"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:paddingStart="@dimen/double_spacing"
                android:paddingEnd="@dimen/double_spacing">
                <TextView
                    android:textSize="14sp"
                    android:textColor="@color/eternity"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="@string/trunk_speaker_device_name_label"
                    android:fontFamily="@font/louisvuitton_regular"/>
                <com.vuitton.android.presentation.screen.connectivity.views.ClickableEditText
                    android:textSize="16sp"
                    android:id="@+id/speaker_name"
                    android:background="@drawable/shape_repaint_rectangle"
                    android:padding="16dp"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="12dp"
                    android:layout_marginBottom="@dimen/triple_spacing"
                    android:hint="@string/speaker_trunk_detail_device_name_field_hint"
                    android:maxLength="30"
                    android:inputType="textCapSentences"
                    android:imeOptions="actionDone"
                    android:fontFamily="@font/louisvuitton_regular"
                    style="@style/FormEditText.Cancellable"/>
                <View
                    android:background="@color/egg_shell"
                    android:layout_width="match_parent"
                    android:layout_height="1dp"/>
                <LinearLayout
                    android:gravity="center_vertical"
                    android:orientation="horizontal"
                    android:id="@+id/disposition_layout"
                    android:paddingTop="@dimen/triple_spacing"
                    android:paddingBottom="@dimen/triple_spacing"
                    android:focusable="true"
                    android:clickable="true"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:foreground="?android:attr/selectableItemBackground">
                    <TextView
                        android:textColor="@color/eternity"
                        android:background="@drawable/selector_item_list_selectable_background"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:text="@string/trunk_speaker_device_channel"
                        android:layout_weight="1"
                        android:fontFamily="@font/louisvuitton_medium"
                        android:textDirection="locale"
                        style="@style/ListLabelLMediumLeftDark"/>
                    <TextView
                        android:textColor="@color/eternity"
                        android:id="@+id/text_speaker_preset"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="@string/trunk_speaker_channel_stereo"
                        android:fontFamily="@font/louisvuitton_regular"
                        android:textDirection="locale"
                        android:layout_marginEnd="@dimen/triple_spacing"
                        style="@style/ListLabelLMediumLeftDark"/>
                    <ImageView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:src="@drawable/ic_arrow_right_12dp"/>
                </LinearLayout>
                <View
                    android:id="@+id/divider_faq"
                    android:background="@color/egg_shell"
                    android:visibility="gone"
                    android:layout_width="match_parent"
                    android:layout_height="1dp"/>
                <TextView
                    android:textColor="@color/eternity"
                    android:id="@+id/btn_faq"
                    android:background="@drawable/selector_item_list_selectable_background"
                    android:paddingTop="24dp"
                    android:paddingBottom="24dp"
                    android:visibility="gone"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:foreground="?android:attr/selectableItemBackground"
                    android:fontFamily="@font/louisvuitton_medium"
                    android:textDirection="locale"
                    app:drawableEndCompat="@drawable/ic_arrow_right_12dp"
                    style="@style/ListLabelLMediumLeftDark"/>
            </LinearLayout>
            <Button
                android:gravity="center"
                android:id="@+id/btn_open_spotify"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/triple_spacing"
                android:layout_marginStart="@dimen/double_spacing"
                android:layout_marginEnd="@dimen/double_spacing"
                style="@style/BlackButton"/>
            <Button
                android:id="@+id/button_reset_device"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/double_spacing"
                android:layout_marginBottom="@dimen/triple_spacing"
                android:text="@string/speaker_trunk_detail_reset_device_btn_label"
                android:layout_marginStart="@dimen/double_spacing"
                android:layout_marginEnd="@dimen/double_spacing"
                style="@style/SecondaryButtonRepaint"/>
        </LinearLayout>
    </androidx.core.widget.NestedScrollView>
    <View
        android:id="@+id/shadow"
        android:background="@drawable/shape_shadow_top"
        android:layout_width="match_parent"
        android:layout_height="8dp"
        android:layout_above="@+id/equalizer_wrapper"/>
    <LinearLayout
        android:orientation="vertical"
        android:id="@+id/equalizer_wrapper"
        android:background="@color/white"
        android:paddingBottom="@dimen/double_spacing"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_alignParentBottom="true">
        <TextView
            android:textSize="16sp"
            android:textStyle="normal"
            android:textColor="@color/camo_green"
            android:paddingTop="@dimen/double_spacing"
            android:paddingBottom="@dimen/double_spacing"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="@string/equalizer_description"
            android:lineSpacingExtra="4sp"
            android:fontFamily="@font/louisvuitton_regular"
            android:paddingStart="@dimen/double_spacing"
            android:paddingEnd="@dimen/double_spacing"
            android:letterSpacing="0.03"/>
        <Button
            android:gravity="center"
            android:id="@+id/btn_open_equalizer"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="@string/speaker_trunk_equalizer_btn_label"
            android:layout_marginStart="@dimen/double_spacing"
            android:layout_marginEnd="@dimen/double_spacing"
            style="@style/BlackButton"/>
    </LinearLayout>
    <FrameLayout
        android:id="@+id/progress_bar"
        android:background="@color/transparent_background_white_50"
        android:focusable="true"
        android:visibility="gone"
        android:clickable="true"
        android:layout_width="match_parent"
        android:layout_height="match_parent">
        <ProgressBar
            android:layout_gravity="center"
            android:layout_width="32dp"
            android:layout_height="32dp"
            android:contentDescription="@string/content_description_loading"
            style="@style/LVProgressBarDark"/>
    </FrameLayout>
</RelativeLayout>
