<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:background="@drawable/border_top_radius_16dp_white"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:paddingStart="@dimen/double_spacing"
    android:paddingEnd="@dimen/double_spacing">
    <TextView
        android:id="@+id/text_device_found_title"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginTop="@dimen/triple_spacing"
        android:layout_marginStart="@dimen/double_spacing"
        android:layout_marginEnd="@dimen/double_spacing"
        app:layout_constraintBottom_toTopOf="@+id/text_light_up_confirmation"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent"
        style="@style/HeadingH5CenterDark"/>
    <TextView
        android:id="@+id/text_light_up_confirmation"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginTop="@dimen/default_spacing"
        android:layout_marginBottom="@dimen/default_spacing"
        android:fontFamily="@font/louisvuitton_regular"
        app:layout_constraintBottom_toTopOf="@+id/image_light_up_confirmation"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/text_device_found_title"
        style="@style/ListLabelXlRegularCenterGrey"/>
    <ImageView
        android:id="@+id/image_light_up_confirmation"
        android:layout_width="match_parent"
        android:layout_height="300dp"
        android:src="@drawable/image_light_up_keep_all_detected"
        android:scaleType="fitCenter"
        app:layout_constraintBottom_toTopOf="@+id/button_confirm_pairing"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/text_light_up_confirmation"/>
    <Button
        android:id="@+id/button_confirm_pairing"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="@dimen/double_spacing"
        android:text="@string/confirm"
        app:layout_constraintBottom_toTopOf="@+id/button_cancel_pairing"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/image_light_up_confirmation"
        style="@style/BlackButtonRepaint"/>
    <Button
        android:id="@+id/button_cancel_pairing"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="@dimen/default_spacing"
        android:layout_marginBottom="@dimen/double_spacing"
        android:text="@android:string/cancel"
        android:textAllCaps="false"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/button_confirm_pairing"
        style="@style/SecondaryButtonRepaint"/>
</androidx.constraintlayout.widget.ConstraintLayout>
