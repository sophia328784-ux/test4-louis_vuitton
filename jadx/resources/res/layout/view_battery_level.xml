<?xml version="1.0" encoding="utf-8"?>
<RelativeLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="wrap_content"
    android:layout_height="wrap_content">
    <ImageView
        android:id="@+id/battery_level_image"
        android:layout_width="24dp"
        android:layout_height="24dp"/>
    <TextView
        android:textSize="@dimen/text_size_list_label_l"
        android:id="@+id/battery_level_percentage"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_alignTop="@+id/battery_level_image"
        android:layout_alignBottom="@+id/battery_level_image"
        android:fontFamily="@font/louisvuitton_regular"
        android:textDirection="locale"
        android:layout_marginStart="@dimen/default_spacing"
        android:layout_toEndOf="@+id/battery_level_image"
        style="@style/ListLabelLRegularLeftDark"/>
</RelativeLayout>
