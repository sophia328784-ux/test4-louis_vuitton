<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:orientation="vertical"
    android:background="@drawable/border_top_radius_16dp_white"
    android:paddingBottom="@dimen/double_spacing"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:paddingStart="@dimen/double_spacing"
    android:paddingEnd="@dimen/double_spacing">
    <TextView
        android:id="@+id/text_title"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="@dimen/triple_spacing"
        android:text="@string/speaker_activate_bt_device_title"
        android:layout_marginStart="@dimen/double_spacing"
        android:layout_marginEnd="@dimen/double_spacing"
        style="@style/HeadingH5CenterDark"/>
    <TextView
        android:id="@+id/text_subtitle"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="@dimen/default_spacing"
        android:layout_marginBottom="@dimen/triple_spacing"
        android:text="@string/speaker_activate_bt_device_subtitle"
        android:fontFamily="@font/louisvuitton_regular"
        style="@style/ListLabelXlRegularCenterGrey"/>
    <LinearLayout
        android:orientation="horizontal"
        android:layout_width="match_parent"
        android:layout_height="wrap_content">
        <Button
            android:id="@+id/button_back"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="@string/back"
            android:layout_weight="1"
            android:textAllCaps="false"
            android:layout_marginEnd="@dimen/small_spacing"
            style="@style/SecondaryButtonRepaint"/>
        <Button
            android:id="@+id/button_next"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="@string/ls_next"
            android:layout_weight="1"
            android:layout_marginStart="@dimen/small_spacing"
            style="@style/BlackButtonRepaint"/>
    </LinearLayout>
</LinearLayout>
