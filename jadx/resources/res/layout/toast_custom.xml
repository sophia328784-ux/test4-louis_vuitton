<?xml version="1.0" encoding="utf-8"?>
<androidx.cardview.widget.CardView xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_marginStart="24dp"
    android:layout_marginEnd="24dp"
    app:cardCornerRadius="4dp">
    <LinearLayout
        android:gravity="center"
        android:layout_width="match_parent"
        android:layout_height="match_parent">
        <ImageView
            android:id="@+id/toast_image"
            android:padding="2dp"
            android:visibility="gone"
            android:layout_width="56dp"
            android:layout_height="64dp"
            android:src="@drawable/ic_check_legacy"
            android:scaleType="fitCenter"/>
        <ImageView
            android:id="@+id/toast_icon"
            android:background="@color/safran"
            android:padding="16dp"
            android:visibility="gone"
            android:layout_width="56dp"
            android:layout_height="64dp"
            android:src="@drawable/ic_check_legacy"
            android:scaleType="fitCenter"/>
        <TextView
            android:textSize="@dimen/text_size_list_label_l"
            android:textColor="@color/eternity"
            android:gravity="center_vertical"
            android:id="@+id/toast_text"
            android:layout_width="match_parent"
            android:layout_height="64dp"
            android:fontFamily="@font/louisvuitton_regular"
            android:layout_marginStart="16dp"
            android:layout_marginEnd="16dp"/>
    </LinearLayout>
</androidx.cardview.widget.CardView>
