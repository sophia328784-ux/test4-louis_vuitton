<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content">
    <com.sightcall.universal.internal.proposition.SignatureView
        android:id="@+id/universal_proposition_signature"
        android:visibility="gone"
        android:layout_width="match_parent"
        android:layout_height="300dp"/>
    <LinearLayout
        android:orientation="vertical"
        android:layout_width="match_parent"
        android:layout_height="match_parent">
        <TextView
            android:textAppearance="@style/TextAppearance.AppCompat.Title"
            android:id="@+id/universal_proposition_title"
            android:paddingLeft="24dp"
            android:paddingTop="24dp"
            android:paddingRight="24dp"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"/>
        <FrameLayout
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_weight="1">
            <ScrollView
                android:id="@+id/universal_proposition_message_root"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:overScrollMode="ifContentScrolls">
                <TextView
                    android:id="@+id/universal_proposition_message"
                    android:paddingLeft="24dp"
                    android:paddingTop="20dp"
                    android:paddingRight="24dp"
                    android:paddingBottom="20dp"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    style="@style/TextAppearance.AppCompat.Subhead"/>
            </ScrollView>
        </FrameLayout>
        <androidx.constraintlayout.widget.ConstraintLayout
            android:gravity="center_vertical"
            android:orientation="horizontal"
            android:paddingLeft="8dp"
            android:paddingTop="8dp"
            android:paddingRight="8dp"
            android:paddingBottom="4dp"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:divider="@drawable/universal_divider_8dp"
            android:showDividers="middle"
            style="?attr/buttonBarStyle">
            <androidx.appcompat.widget.AppCompatImageButton
                android:id="@+id/universal_proposition_reset"
                android:background="?attr/selectableItemBackgroundBorderless"
                android:visibility="invisible"
                android:layout_width="48dp"
                android:layout_height="match_parent"
                android:src="@drawable/universal_ic_refresh_24dp"
                android:scaleType="centerInside"
                android:adjustViewBounds="true"
                app:layout_constraintBottom_toBottomOf="parent"
                app:layout_constraintStart_toStartOf="parent"
                app:tint="@color/universal_color_signature_reset_tint"/>
            <androidx.appcompat.widget.AppCompatButton
                android:id="@+id/universal_proposition_deny"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/universal_proposition_deny"
                app:flow_horizontalAlign="end"
                app:layout_constraintBottom_toTopOf="@+id/universal_proposition_confirm"
                app:layout_constraintEnd_toEndOf="@+id/universal_proposition_confirm"
                style="?attr/buttonBarPositiveButtonStyle"/>
            <androidx.appcompat.widget.AppCompatButton
                android:id="@+id/universal_proposition_confirm"
                android:visibility="gone"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/universal_proposition_confirm"
                app:flow_horizontalAlign="end"
                app:layout_constraintBottom_toTopOf="@+id/universal_proposition_accept"
                app:layout_constraintEnd_toEndOf="@+id/universal_proposition_accept"
                style="?attr/buttonBarPositiveButtonStyle"/>
            <androidx.appcompat.widget.AppCompatButton
                android:id="@+id/universal_proposition_accept"
                android:visibility="gone"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/universal_proposition_accept"
                app:flow_horizontalAlign="end"
                app:layout_constraintBottom_toBottomOf="parent"
                app:layout_constraintEnd_toEndOf="parent"
                style="?attr/buttonBarPositiveButtonStyle"/>
        </androidx.constraintlayout.widget.ConstraintLayout>
    </LinearLayout>
    <com.sightcall.universal.ui.IndeterminateImageView
        android:layout_gravity="center"
        android:id="@+id/universal_proposition_progress"
        android:layout_width="60dp"
        android:layout_height="60dp"
        android:layout_margin="16dp"
        app:indeterminate_color="@color/universal_colorLoadingProgress"/>
</FrameLayout>
