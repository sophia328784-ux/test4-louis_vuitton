<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:orientation="vertical"
    android:layout_width="match_parent"
    android:layout_height="match_parent">
    <com.google.android.material.appbar.AppBarLayout
        android:id="@+id/app_bar_layout"
        android:layout_width="match_parent"
        android:layout_height="wrap_content">
        <include
            android:id="@+id/airport_toolbar"
            layout="@layout/toolbar_title"/>
        <View
            android:background="@color/westargrey70"
            android:layout_width="wrap_content"
            android:layout_height="1dp"/>
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_margin="8dp">
            <EditText
                android:textSize="@dimen/text_size_body_s"
                android:textColor="@color/eternity"
                android:textColorHint="@color/search_hint"
                android:id="@+id/airport_search_text"
                android:background="@color/off_white"
                android:padding="8dp"
                android:layout_width="0dp"
                android:layout_height="44dp"
                android:hint="@string/content_description_search_button"
                android:lines="1"
                android:singleLine="true"
                android:layout_weight="1"
                android:lineSpacingExtra="8sp"
                android:inputType="textCapSentences"
                android:fontFamily="@font/louisvuitton_light"/>
            <ImageButton
                android:id="@+id/airport_search_button"
                android:background="@color/eternity"
                android:layout_width="44dp"
                android:layout_height="44dp"
                android:src="@drawable/ic_search_white"
                android:contentDescription="@string/content_description_search_button"/>
        </LinearLayout>
        <com.google.android.material.tabs.TabLayout
            android:id="@+id/tab_layout"
            android:layout_width="match_parent"
            android:layout_height="80dp"
            style="@style/TabLayoutStyle"/>
    </com.google.android.material.appbar.AppBarLayout>
    <androidx.viewpager.widget.ViewPager
        android:id="@+id/airport_list_view_pager"
        android:layout_width="match_parent"
        android:layout_height="match_parent"/>
</LinearLayout>
