<?xml version="1.0" encoding="utf-8"?>
<merge xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:keepScreenOn="true">
    <com.sightcall.universal.internal.view.MyScreenshareConsumerView
        android:layout_gravity="center"
        android:id="@+id/universal_screenshare_consumer_view"
        android:visibility="gone"
        android:layout_width="match_parent"
        android:layout_height="match_parent"/>
    <com.sightcall.universal.internal.view.ProgressivexImageView
        android:layout_gravity="center"
        android:id="@+id/universal_progressivex_imageview"
        android:visibility="gone"
        android:layout_width="match_parent"
        android:layout_height="match_parent"/>
    <com.sightcall.universal.internal.view.MyScreenshareProducerWebView
        android:layout_gravity="center"
        android:id="@+id/universal_screenshare_producer_webview"
        android:visibility="gone"
        android:clipChildren="false"
        android:clipToPadding="false"
        android:layout_width="match_parent"
        android:layout_height="match_parent"/>
    <ProgressBar
        android:layout_gravity="top"
        android:id="@+id/universal_screenshare_producer_webview_progress"
        android:focusable="false"
        android:focusableInTouchMode="false"
        android:visibility="gone"
        android:clickable="false"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:indeterminate="true"
        style="@style/Widget.AppCompat.ProgressBar.Horizontal"/>
    <com.sightcall.universal.internal.view.MyVideoConsumerView
        android:layout_gravity="center"
        android:id="@+id/universal_consumer_view"
        android:visibility="gone"
        android:layout_width="match_parent"
        android:layout_height="match_parent"/>
    <com.sightcall.universal.internal.view.MyVideoConsumerThumbnailContainer
        android:scrollbarStyle="outsideOverlay"
        android:layout_gravity="bottom|left"
        android:id="@+id/universal_video_consumer_thumbnail_container"
        android:padding="@dimen/universal_thumbnail_margin"
        android:visibility="gone"
        android:clipChildren="false"
        android:clipToPadding="false"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:overScrollMode="never">
        <LinearLayout
            android:orientation="horizontal"
            android:clipChildren="false"
            android:clipToPadding="false"
            android:layout_width="wrap_content"
            android:layout_height="@dimen/universal_thumbnail_size"
            android:baselineAligned="false"
            android:divider="@drawable/universal_thumbnail_divider"
            android:showDividers="middle"/>
    </com.sightcall.universal.internal.view.MyVideoConsumerThumbnailContainer>
    <com.sightcall.universal.internal.view.MyVideoProducerWrapper
        android:layout_gravity="center"
        android:id="@+id/universal_video_producer_wrapper"
        android:visibility="gone"
        android:layout_width="match_parent"
        android:layout_height="match_parent">
        <ViewStub
            android:layout_gravity="center"
            android:id="@+id/universal_video_producer_player"
            android:visibility="gone"
            android:layout_width="match_parent"
            android:layout_height="match_parent"/>
        <com.sightcall.universal.internal.view.MyVideoProducerCameraView
            android:layout_gravity="center"
            android:id="@+id/universal_video_producer_camera"
            android:visibility="gone"
            android:layout_width="match_parent"
            android:layout_height="match_parent"/>
        <com.sightcall.universal.internal.view.UvcPreview
            android:layout_gravity="center"
            android:id="@+id/universal_video_producer_uvc"
            android:visibility="gone"
            android:layout_width="match_parent"
            android:layout_height="match_parent"/>
    </com.sightcall.universal.internal.view.MyVideoProducerWrapper>
    <com.sightcall.universal.internal.messaging.TouchThroughRecyclerView
        android:layout_gravity="center_horizontal"
        android:id="@+id/universal_overlay_messages"
        android:paddingLeft="32dp"
        android:paddingTop="@dimen/universal_call_button_bar_height"
        android:paddingRight="32dp"
        android:paddingBottom="@dimen/universal_call_button_bar_height"
        android:visibility="gone"
        android:clipChildren="false"
        android:clipToPadding="false"
        android:layout_width="@dimen/universal_messages_overlay_width"
        android:layout_height="match_parent"
        android:overScrollMode="ifContentScrolls"/>
    <FrameLayout
        android:id="@+id/universal_fitSystemWindows"
        android:fitsSystemWindows="true"
        android:clipChildren="false"
        android:clipToPadding="false"
        android:layout_width="match_parent"
        android:layout_height="match_parent">
        <ImageView
            android:layout_gravity="center"
            android:id="@+id/universal_call_status_no_media"
            android:visibility="gone"
            android:layout_width="96dp"
            android:layout_height="96dp"
            android:layout_marginBottom="@dimen/universal_call_button_bar_height"
            android:src="@drawable/universal_ic_call_status_no_media"/>
        <ImageView
            android:layout_gravity="center"
            android:id="@+id/universal_call_status_screencasting"
            android:visibility="gone"
            android:layout_width="96dp"
            android:layout_height="96dp"
            android:layout_marginBottom="@dimen/universal_call_button_bar_height"
            android:src="@drawable/universal_ic_call_status_screencast"/>
        <com.sightcall.universal.internal.view.CallButtonBar
            android:gravity="top"
            android:layout_gravity="top"
            android:orientation="horizontal"
            android:id="@+id/universal_call_bar_remote"
            android:background="@drawable/universal_top_bar_background"
            android:visibility="gone"
            android:clipChildren="false"
            android:layout_width="match_parent"
            android:layout_height="@dimen/universal_call_button_bar_height"
            android:baselineAligned="false"/>
        <ImageView
            android:layout_gravity="end"
            android:id="@+id/universal_button_open_panel"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:src="0x7f0803fe"
            android:text="Live Translation"/>
        <androidx.constraintlayout.widget.ConstraintLayout
            android:id="@+id/universal_panel_setting_container"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"/>
        <androidx.constraintlayout.widget.ConstraintLayout
            android:id="@+id/universal_live_sentences_container"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:layout_marginBottom="@dimen/universal_call_button_bar_height"/>
        <androidx.coordinatorlayout.widget.CoordinatorLayout
            android:id="@+id/universal_history_container"
            android:layout_width="match_parent"
            android:layout_height="match_parent"/>
        <LinearLayout
            android:layout_gravity="bottom"
            android:orientation="vertical"
            android:background="@drawable/universal_bottom_bar_background"
            android:clipChildren="false"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:baselineAligned="false">
            <ViewStub
                android:orientation="horizontal"
                android:id="@+id/universal_video_player_bar"
                android:layout_width="match_parent"
                android:layout_height="@dimen/universal_call_button_bar_height"
                android:baselineAligned="false"/>
            <com.sightcall.universal.internal.view.CallButtonBar
                android:gravity="bottom"
                android:orientation="horizontal"
                android:id="@+id/universal_call_local_bar"
                android:clipChildren="false"
                android:layout_width="match_parent"
                android:layout_height="@dimen/universal_call_button_bar_height"
                android:baselineAligned="false"/>
        </LinearLayout>
    </FrameLayout>
</merge>
