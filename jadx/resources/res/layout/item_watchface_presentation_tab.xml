<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:gravity="center_horizontal"
    android:orientation="vertical"
    android:layout_width="wrap_content"
    android:layout_height="wrap_content">
    <ImageView
        android:id="@+id/watchface_presentation_image"
        android:layout_width="80dp"
        android:layout_height="80dp"
        android:layout_marginTop="16dp"
        android:layout_marginBottom="16dp"
        android:layout_marginStart="40dp"
        android:layout_marginEnd="40dp"/>
    <TextView
        android:textSize="@dimen/text_size_list_label_s"
        android:textColor="@color/eternity"
        android:gravity="center"
        android:id="@+id/watchface_presentation_name"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginBottom="16dp"
        android:lines="1"
        android:minLines="1"
        android:textAllCaps="true"
        android:fontFamily="@font/louisvuitton_medium"/>
    <View
        android:id="@+id/watchface_presentation_indicator"
        android:background="@color/black"
        android:layout_width="match_parent"
        android:layout_height="4dp"/>
</LinearLayout>
