<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/root_layout"
    android:background="@color/black"
    android:layout_width="match_parent"
    android:layout_height="match_parent">
    <include
        android:id="@+id/layout_toolbar"
        layout="@layout/toolbar_web_view"/>
    <View
        android:id="@+id/web_view_background"
        android:background="@color/off_white"
        android:layout_width="0dp"
        android:layout_height="0dp"
        app:layout_constraintBottom_toTopOf="@+id/legal_mentions_button"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/layout_toolbar"/>
    <FrameLayout
        android:id="@+id/web_view_parent_container"
        android:layout_width="0dp"
        android:layout_height="0dp"
        app:layout_constraintBottom_toBottomOf="@+id/web_view_background"
        app:layout_constraintEnd_toEndOf="@+id/web_view_background"
        app:layout_constraintStart_toStartOf="@+id/web_view_background"
        app:layout_constraintTop_toTopOf="@+id/web_view_background">
        <WebView
            android:id="@+id/web_view"
            android:layout_width="match_parent"
            android:layout_height="match_parent"/>
    </FrameLayout>
    <Button
        android:textSize="@dimen/text_size_button"
        android:textColor="@android:color/white"
        android:gravity="center"
        android:id="@+id/legal_mentions_button"
        android:background="@color/eternity"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="@string/legal_privacy"
        android:textAllCaps="false"
        android:fontFamily="@font/louisvuitton_regular"
        app:layout_constraintBottom_toBottomOf="parent"/>
    <ProgressBar
        android:layout_gravity="center"
        android:id="@+id/progress"
        android:layout_width="32dp"
        android:layout_height="32dp"
        android:contentDescription="@string/content_description_loading"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent"
        style="@style/LVProgressBarDark"/>
</androidx.constraintlayout.widget.ConstraintLayout>
