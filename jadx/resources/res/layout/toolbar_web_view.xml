<?xml version="1.0" encoding="utf-8"?>
<com.google.android.material.appbar.AppBarLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    app:elevation="@dimen/no_elevation"
    style="@style/AppBarLayoutStyle">
    <FrameLayout
        android:layout_width="match_parent"
        android:layout_height="match_parent">
        <androidx.appcompat.widget.Toolbar
            android:id="@+id/toolbar_web_view"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            app:contentInsetStart="0dp"
            app:layout_scrollFlags="enterAlways|scroll">
            <ImageView
                android:layout_gravity="center"
                android:id="@+id/toolbar_web_view_image"
                android:layout_width="32dp"
                android:layout_height="32dp"
                android:src="@drawable/ic_lv_logo"/>
        </androidx.appcompat.widget.Toolbar>
        <androidx.appcompat.widget.AppCompatTextView
            android:textSize="@dimen/text_size_h5"
            android:textColor="@color/eternity"
            android:ellipsize="end"
            android:gravity="center"
            android:layout_gravity="center"
            android:id="@+id/toolbar_web_view_title"
            android:visibility="gone"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:maxLines="1"
            android:layout_marginStart="56dp"
            android:layout_marginEnd="56dp"
            app:fontFamily="@font/louisvuitton_regular"/>
    </FrameLayout>
    <include layout="@layout/view_divider_1dp"/>
</com.google.android.material.appbar.AppBarLayout>
