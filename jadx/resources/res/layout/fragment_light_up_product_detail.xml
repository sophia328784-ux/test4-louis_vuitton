<?xml version="1.0" encoding="utf-8"?>
<RelativeLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent">
    <include
        android:id="@+id/layout_light_up_toolbar"
        layout="@layout/toolbar_simple"/>
    <androidx.core.widget.NestedScrollView
        android:id="@+id/scroll_view_wrapper"
        android:background="@color/off_white"
        android:visibility="invisible"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:fillViewport="true"
        android:layout_below="@+id/layout_light_up_toolbar">
        <LinearLayout
            android:orientation="vertical"
            android:layout_width="match_parent"
            android:layout_height="wrap_content">
            <RelativeLayout
                android:layout_width="match_parent"
                android:layout_height="360dp">
                <include
                    android:id="@+id/layout_update_section"
                    android:visibility="gone"
                    layout="@layout/in_app_notification"/>
                <com.vuitton.android.presentation.screen.connectivity.views.FixedAspectRatioImageView
                    android:id="@+id/image_product"
                    android:layout_width="match_parent"
                    android:layout_height="360dp"
                    android:scaleType="centerCrop"
                    app:imageViewAspectRatio="1:1"/>
                <TextView
                    android:id="@+id/text_product_title"
                    android:paddingBottom="@dimen/triple_spacing"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_alignParentBottom="true"
                    android:paddingStart="@dimen/double_spacing"
                    android:paddingEnd="@dimen/double_spacing"
                    style="@style/HeadingH2LeftLight"/>
            </RelativeLayout>
            <LinearLayout
                android:orientation="vertical"
                android:id="@+id/layout_presets"
                android:visibility="gone"
                android:layout_width="match_parent"
                android:layout_height="wrap_content">
                <TextView
                    android:id="@+id/text_presets_title"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="@dimen/triple_spacing"
                    android:layout_marginBottom="@dimen/default_spacing"
                    android:text="@string/light_up_presets_title"
                    android:textDirection="locale"
                    android:layout_marginStart="@dimen/double_spacing"
                    android:layout_marginEnd="@dimen/double_spacing"
                    style="@style/HeadingH4LeftDark"/>
                <androidx.recyclerview.widget.RecyclerView
                    android:orientation="horizontal"
                    android:id="@+id/recycler_presets"
                    android:clipToPadding="false"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:paddingStart="@dimen/midplus_spacing"
                    android:paddingEnd="@dimen/midplus_spacing"
                    app:layoutManager="androidx.recyclerview.widget.LinearLayoutManager"/>
            </LinearLayout>
            <TextView
                android:id="@+id/text_information_title"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/double_spacing"
                android:layout_marginBottom="@dimen/double_spacing"
                android:text="@string/light_up_documentation_title"
                android:textDirection="locale"
                android:layout_marginStart="@dimen/double_spacing"
                android:layout_marginEnd="@dimen/double_spacing"
                style="@style/HeadingH4LeftDark"/>
            <LinearLayout
                android:orientation="vertical"
                android:id="@+id/layout_subsection"
                android:background="@android:color/white"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:divider="@drawable/light_up_divider"
                android:showDividers="middle"/>
            <Button
                android:id="@+id/button_unpair"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/triple_spacing"
                android:layout_marginBottom="@dimen/huge_spacing"
                android:text="@string/p12_unpair_title"
                android:layout_marginStart="@dimen/triple_spacing"
                android:layout_marginEnd="@dimen/triple_spacing"
                style="@style/SecondaryButtonRepaint"/>
        </LinearLayout>
    </androidx.core.widget.NestedScrollView>
    <RelativeLayout
        android:id="@+id/layout_connection_in_progress"
        android:background="@color/white"
        android:focusable="true"
        android:visibility="gone"
        android:clickable="true"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:layout_below="@+id/layout_light_up_toolbar">
        <TextView
            android:gravity="center"
            android:id="@+id/text_connection_title"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="96dp"
            android:text="@string/light_up_connection_in_progress"
            android:layout_marginStart="@dimen/double_spacing"
            android:layout_marginEnd="@dimen/double_spacing"
            style="@style/HeadingH4CenterDark"/>
        <TextView
            android:id="@+id/text_connection_subtitle"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/default_spacing"
            android:layout_marginBottom="@dimen/double_spacing"
            android:text="@string/light_up_connection_in_progress_subtitle"
            android:layout_below="@+id/text_connection_title"
            android:fontFamily="@font/louisvuitton_regular"
            android:layout_marginStart="@dimen/double_spacing"
            android:layout_marginEnd="@dimen/double_spacing"
            style="@style/ListLabelXlRegularCenterGrey"/>
        <ProgressBar
            android:id="@+id/progress"
            android:layout_width="@dimen/progress_bar_size"
            android:layout_height="@dimen/progress_bar_size"
            android:layout_below="@+id/text_connection_subtitle"
            android:layout_centerHorizontal="true"
            android:contentDescription="@string/content_description_loading"
            android:indeterminateTint="@color/eternity"/>
        <ImageView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/double_huge_spacing"
            android:src="@drawable/ic_light_up_loader"
            android:layout_below="@+id/progress"
            android:layout_centerHorizontal="true"/>
    </RelativeLayout>
</RelativeLayout>
