<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="wrap_content"
    android:layout_height="wrap_content">
    <androidx.cardview.widget.CardView
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:layout_margin="8dp"
        app:cardCornerRadius="4dp"
        app:cardElevation="4dp">
        <LinearLayout
            android:layout_gravity="center_horizontal"
            android:orientation="vertical"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginLeft="16dp"
            android:layout_marginTop="16dp"
            android:layout_marginRight="16dp">
            <androidx.appcompat.widget.AppCompatTextView
                android:gravity="center_vertical"
                android:id="@+id/universal_gps_coordinates"
                android:focusable="true"
                android:clickable="true"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_margin="4dp"
                android:text="@string/universal_location_popup_coordinates"
                android:drawableLeft="@drawable/universal_ic_person_pin_circle_24dp"
                android:drawablePadding="8dp"/>
            <androidx.appcompat.widget.AppCompatTextView
                android:gravity="center_vertical"
                android:id="@+id/universal_gps_accuracy"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_margin="4dp"
                android:text="@string/universal_location_popup_accuracy"
                android:drawableLeft="@drawable/universal_ic_straighten_24dp"
                android:drawablePadding="8dp"/>
            <com.sightcall.universal.internal.ui.TimeAgoTextView
                android:gravity="center_vertical"
                android:id="@+id/universal_gps_timestamp"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_margin="4dp"
                android:text="@string/universal_location_popup_timestamp"
                android:drawableLeft="@drawable/universal_ic_access_time_24dp"
                android:drawablePadding="8dp"/>
            <LinearLayout
                android:gravity="center_vertical"
                android:layout_gravity="center_horizontal"
                android:orientation="horizontal"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="16dp">
                <com.sightcall.universal.ui.IndeterminateImageView
                    android:id="@+id/universal_gps_progress"
                    android:visibility="invisible"
                    android:layout_width="30dp"
                    android:layout_height="30dp"
                    app:indeterminate_padding="4dp"
                    app:indeterminate_strokeWidth="2dp"/>
                <androidx.appcompat.widget.AppCompatButton
                    android:id="@+id/universal_gps_request"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="@string/universal_location_popup_request_initial"
                    style="?attr/buttonBarPositiveButtonStyle"/>
                <Space
                    android:layout_width="30dp"
                    android:layout_height="30dp"/>
            </LinearLayout>
        </LinearLayout>
    </androidx.cardview.widget.CardView>
</FrameLayout>
