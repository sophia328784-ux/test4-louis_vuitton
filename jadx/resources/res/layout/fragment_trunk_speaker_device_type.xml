<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:orientation="vertical"
    android:background="@drawable/border_top_radius_16dp_white"
    android:paddingBottom="@dimen/double_spacing"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:paddingStart="@dimen/double_spacing"
    android:paddingEnd="@dimen/double_spacing">
    <TextView
        android:id="@+id/text_title"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="@dimen/triple_spacing"
        android:text="@string/trunk_choose_your_speakers_title"
        android:layout_marginStart="@dimen/double_spacing"
        android:layout_marginEnd="@dimen/triple_spacing"
        style="@style/HeadingH5CenterDark"/>
    <TextView
        android:id="@+id/text_subtitle"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="@dimen/default_spacing"
        android:layout_marginBottom="@dimen/triple_spacing"
        android:text="@string/trunk_choose_your_speakers_subtitle"
        android:fontFamily="@font/louisvuitton_regular"
        style="@style/ListLabelXlRegularCenterGrey"/>
    <LinearLayout
        android:orientation="horizontal"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginBottom="@dimen/double_spacing"
        android:baselineAligned="false">
        <FrameLayout
            android:background="@drawable/shadow_trunk_speaker_device_type"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1">
            <androidx.cardview.widget.CardView
                android:id="@+id/card_speaker_gm"
                android:focusable="true"
                android:clickable="true"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:foreground="?attr/selectableItemBackground"
                app:cardCornerRadius="@dimen/repaint_card_view_radius"
                app:cardElevation="@dimen/no_elevation">
                <LinearLayout
                    android:orientation="vertical"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content">
                    <com.vuitton.android.presentation.screen.connectivity.views.FixedAspectRatioImageView
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:src="0x7f080398"
                        android:scaleType="centerCrop"
                        app:imageViewAspectRatio="1:1"/>
                    <TextView
                        android:gravity="center_vertical"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="@dimen/double_spacing"
                        android:layout_marginBottom="@dimen/triple_spacing"
                        android:text="@string/trunk_speaker_gm"
                        android:lines="2"
                        android:textAllCaps="true"
                        android:fontFamily="@font/louisvuitton_medium"
                        android:layout_marginStart="@dimen/double_spacing"
                        android:layout_marginEnd="@dimen/double_spacing"
                        style="@style/ListLabelMMediumLeftDark"/>
                </LinearLayout>
            </androidx.cardview.widget.CardView>
        </FrameLayout>
        <FrameLayout
            android:background="@drawable/shadow_trunk_speaker_device_type"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1">
            <androidx.cardview.widget.CardView
                android:id="@+id/card_speaker_pm"
                android:focusable="true"
                android:clickable="true"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:foreground="?attr/selectableItemBackground"
                app:cardCornerRadius="@dimen/repaint_card_view_radius"
                app:cardElevation="@dimen/no_elevation">
                <LinearLayout
                    android:orientation="vertical"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content">
                    <com.vuitton.android.presentation.screen.connectivity.views.FixedAspectRatioImageView
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:src="0x7f08039a"
                        android:scaleType="centerCrop"
                        app:imageViewAspectRatio="1:1"/>
                    <TextView
                        android:gravity="center_vertical"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="@dimen/double_spacing"
                        android:layout_marginBottom="@dimen/triple_spacing"
                        android:text="@string/trunk_speaker_pm"
                        android:lines="2"
                        android:textAllCaps="true"
                        android:fontFamily="@font/louisvuitton_medium"
                        android:layout_marginStart="@dimen/double_spacing"
                        android:layout_marginEnd="@dimen/double_spacing"
                        style="@style/ListLabelMMediumLeftDark"/>
                </LinearLayout>
            </androidx.cardview.widget.CardView>
        </FrameLayout>
    </LinearLayout>
</LinearLayout>
