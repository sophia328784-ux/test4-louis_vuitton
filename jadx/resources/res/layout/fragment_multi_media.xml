<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent">
    <FrameLayout
        android:id="@+id/main"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent"/>
    <com.google.android.material.button.MaterialButton
        android:id="@+id/photoLibrary"
        android:visibility="gone"
        android:layout_width="@dimen/side_icon_width"
        android:layout_height="@dimen/side_icon_width"
        android:layout_margin="16dp"
        android:layout_marginEnd="@dimen/back_margin"
        app:backgroundTint="@color/button_background_default"
        app:icon="@drawable/ic_photo_library"
        app:iconSize="@dimen/side_icon_size"
        app:iconTint="@color/white"
        app:layout_constraintEnd_toEndOf="@+id/main"
        app:layout_constraintTop_toBottomOf="@+id/videoLibrary"
        app:strokeColor="@color/white"
        app:strokeWidth="@dimen/back_stroke"
        style="@style/SightCall.CircleIconButton"/>
    <com.google.android.material.button.MaterialButton
        android:id="@+id/videoLibrary"
        android:visibility="gone"
        android:layout_width="@dimen/side_icon_width"
        android:layout_height="@dimen/side_icon_width"
        android:layout_margin="16dp"
        android:layout_marginEnd="@dimen/back_margin"
        app:backgroundTint="@color/button_background_default"
        app:icon="@drawable/ic_video_library"
        app:iconSize="@dimen/side_icon_size"
        app:iconTint="@color/white"
        app:layout_constraintEnd_toEndOf="@+id/main"
        app:layout_constraintTop_toTopOf="@+id/main"
        app:strokeColor="@color/white"
        app:strokeWidth="@dimen/back_stroke"
        style="@style/SightCall.CircleIconButton"/>
</androidx.constraintlayout.widget.ConstraintLayout>
