<?xml version="1.0" encoding="utf-8"?>
<androidx.cardview.widget.CardView xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:background="@android:color/white"
    android:layout_width="@dimen/connectivity_connected_object_width"
    android:layout_height="match_parent"
    android:layout_margin="@dimen/feedcard_multi_product_item_margin"
    android:foreground="?attr/selectableItemBackground"
    app:cardCornerRadius="@dimen/double_spacing"
    app:cardElevation="@dimen/elevation_two">
    <LinearLayout
        android:orientation="vertical"
        android:paddingBottom="@dimen/double_spacing"
        android:layout_width="match_parent"
        android:layout_height="wrap_content">
        <RelativeLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content">
            <com.vuitton.android.presentation.screen.connectivity.views.FixedAspectRatioImageView
                android:id="@+id/image_watch"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:src="@drawable/vertical_watch_image"
                android:scaleType="centerInside"
                app:imageViewAspectRatio="1:1"/>
            <ImageView
                android:id="@+id/image_remove_watch"
                android:padding="@dimen/default_spacing"
                android:visibility="gone"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:src="@drawable/ic_close_16_dp"
                android:layout_alignEnd="@+id/image_watch"/>
        </RelativeLayout>
        <TextView
            android:textSize="@dimen/text_size_list_label_m"
            android:textColor="@color/eternity"
            android:ellipsize="end"
            android:id="@+id/text_watch_name"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/double_spacing"
            android:maxLines="2"
            android:textAllCaps="true"
            android:fontFamily="@font/louisvuitton_medium"
            android:layout_marginStart="@dimen/double_spacing"
            android:layout_marginEnd="@dimen/double_spacing"
            android:letterSpacing="0.03"/>
        <TextView
            android:textSize="@dimen/text_size_list_label_s"
            android:textColor="@color/eternity"
            android:id="@+id/text_watch_flight_address"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/small_spacing"
            android:fontFamily="@font/louisvuitton_regular"
            android:layout_marginStart="@dimen/double_spacing"
            android:layout_marginEnd="@dimen/double_spacing"
            android:letterSpacing="0.03"/>
    </LinearLayout>
</androidx.cardview.widget.CardView>
