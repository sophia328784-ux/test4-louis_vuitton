<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent">
    <androidx.camera.view.PreviewView
        android:id="@+id/cameraPreview"
        android:layout_width="0dp"
        android:layout_height="0dp"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent"/>
    <com.sightcall.graphik.MaskView
        android:id="@+id/maskView"
        android:background="@color/mask_view_color"
        android:visibility="gone"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        app:focusCornerRadius="24dp"
        app:focusMarginHeight="24dp"
        app:focusMarginWidth="24dp"
        app:layout_constraintBottom_toBottomOf="@+id/cameraPreview"
        app:layout_constraintEnd_toEndOf="@+id/cameraPreview"
        app:layout_constraintStart_toStartOf="@+id/cameraPreview"
        app:layout_constraintTop_toTopOf="@+id/cameraPreview"/>
    <com.google.android.material.button.MaterialButton
        android:id="@+id/flashlight"
        android:layout_width="@dimen/side_icon_width"
        android:layout_height="@dimen/side_icon_width"
        android:layout_marginTop="@dimen/back_margin"
        android:layout_marginStart="@dimen/back_margin"
        app:backgroundTint="@color/button_background_default"
        app:icon="@drawable/flashlight_off"
        app:iconTint="@color/white"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent"
        app:strokeColor="@color/white"
        app:strokeWidth="@dimen/back_stroke"
        style="@style/SightCall.CircleIconButton"/>
    <com.google.android.material.button.MaterialButton
        android:id="@+id/back"
        android:layout_width="@dimen/side_icon_width"
        android:layout_height="@dimen/side_icon_width"
        android:layout_marginTop="@dimen/back_margin"
        app:backgroundTint="@color/button_background_default"
        app:icon="@drawable/close"
        app:iconSize="@dimen/side_icon_size"
        app:iconTint="@color/white"
        app:layout_constraintBottom_toTopOf="@+id/mainAction"
        app:layout_constraintEnd_toEndOf="@+id/mainAction"
        app:layout_constraintStart_toStartOf="@+id/mainAction"
        app:layout_constraintTop_toTopOf="parent"
        app:strokeColor="@color/white"
        app:strokeWidth="@dimen/back_stroke"
        style="@style/SightCall.CircleIconButton"/>
    <com.google.android.material.progressindicator.CircularProgressIndicator
        android:id="@+id/circularProgressIndicator"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        app:indicatorColor="@color/progress_indicator_color"
        app:indicatorSize="@dimen/progress_indicator_size"
        app:layout_constraintBottom_toBottomOf="@+id/mainAction"
        app:layout_constraintEnd_toEndOf="@+id/mainAction"
        app:layout_constraintStart_toStartOf="@+id/mainAction"
        app:layout_constraintTop_toTopOf="@+id/mainAction"
        app:trackColor="@color/white"
        app:trackThickness="@dimen/progress_track_thickness"/>
    <com.google.android.material.button.MaterialButton
        android:id="@+id/mainAction"
        android:visibility="gone"
        android:layout_width="@dimen/main_action_size"
        android:layout_height="@dimen/main_action_size"
        android:layout_marginEnd="@dimen/main_action_margin"
        app:backgroundTint="@color/button_background_default"
        app:icon="@drawable/ic_photo_camera"
        app:iconSize="@dimen/main_action_icon_size"
        app:iconTint="@color/white"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintTop_toTopOf="parent"
        app:strokeColor="@color/white"
        app:strokeWidth="@dimen/main_action_stroke"
        style="@style/SightCall.CircleIconButton"/>
    <com.google.android.material.button.MaterialButton
        android:id="@+id/switchCamera"
        android:layout_width="@dimen/side_icon_width"
        android:layout_height="@dimen/side_icon_width"
        android:layout_marginBottom="@dimen/switch_camera_margin"
        app:backgroundTint="@color/button_background_default"
        app:icon="@drawable/ic_switch_mods"
        app:iconSize="@dimen/side_icon_size"
        app:iconTint="@color/white"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="@+id/mainAction"
        app:layout_constraintStart_toStartOf="@+id/mainAction"
        app:layout_constraintTop_toBottomOf="@+id/mainAction"
        app:strokeColor="@color/white"
        app:strokeWidth="@dimen/switch_camera_stroke"
        style="@style/SightCall.CircleIconButton"/>
    <com.google.android.material.chip.Chip
        android:textSize="@dimen/chip_text_size"
        android:textColor="@color/white"
        android:id="@+id/timer"
        android:visibility="gone"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginStart="@dimen/chip_margin"
        android:backgroundTint="@color/timer_background_recording"
        app:layout_constraintBottom_toBottomOf="@+id/mainAction"
        app:layout_constraintEnd_toEndOf="@+id/cameraPreview"
        app:layout_constraintStart_toEndOf="@+id/mainAction"
        app:layout_constraintTop_toTopOf="@+id/mainAction"/>
</androidx.constraintlayout.widget.ConstraintLayout>
